# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (SQLAlchemy URL with the psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://collab:CHANGE_ME@127.0.0.1:5434/collab_pickup

# Secret used to sign and verify JWTs (HS256). Use a long random string.
JWT_SECRET=CHANGE_ME

