  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "releaseAt": {
            "type": "string",
            "format": "date-time",
            "title": "Releaseat",
            "description": "With a time zone, e.g. 2026-11-13T14:00:00-05:00"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "releaseAt",
          "quantity"
        ],
        "title": "BatchRequest"
      },
      "BatchResponse": {
        "properties": {
          "batchId": {
            "type": "string",
            "title": "Batchid"
          },
          "itemId": {
            "type": "string",
            "title": "Itemid"
          },
          "releaseAt": {
            "type": "string",
            "title": "Releaseat"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "remaining": {
            "type": "integer",
            "title": "Remaining"
          }
        },
        "type": "object",
        "required": [
          "batchId",
          "itemId",
          "releaseAt",
          "quantity",
          "remaining"
        ],
        "title": "BatchResponse"
      },
      "BonusResult": {
        "properties": {
          "comboId": {
            "type": "string",
            "title": "Comboid"
          },
          "included": {
            "type": "boolean",
            "title": "Included"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "comboId",
          "included",
          "message"
        ],
        "title": "BonusResult"
      },
      "ClaimedUnit": {
        "properties": {
          "itemId": {
            "type": "string",
            "title": "Itemid"
          },
          "batchId": {
            "type": "string",
            "title": "Batchid"
          },
          "qty": {
            "type": "integer",
            "title": "Qty"
          }
        },
        "type": "object",
        "required": [
          "itemId",
          "batchId",
          "qty"
        ],
        "title": "ClaimedUnit"
      },
      "ComboComponent": {
        "properties": {
          "itemId": {
            "type": "string",
            "title": "Itemid"
          },
          "qty": {
            "type": "integer",
            "title": "Qty"
          }
        },
        "type": "object",
        "required": [
          "itemId",
          "qty"
        ],
        "title": "ComboComponent"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "SOLD_OUT"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Username",
            "examples": [
              "alice"
            ]
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MenuItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "'single' or 'combo'"
          },
          "price": {
            "type": "string",
            "title": "Price",
            "examples": [
              "19.00"
            ]
          },
          "perOrderLimit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Perorderlimit"
          },
          "available": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available",
            "description": "Units on sale now; null = unlimited."
          },
          "components": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ComboComponent"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Components"
          },
          "bonusRemaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bonusremaining"
          },
          "bonusAvailable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bonusavailable"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "price",
          "perOrderLimit",
          "available"
        ],
        "title": "MenuItem"
      },
      "MenuResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "MenuResponse"
      },
      "OrderLineIn": {
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Itemid",
            "examples": [
              "combo-hero-set"
            ]
          },
          "qty": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Qty"
          }
        },
        "type": "object",
        "required": [
          "itemId",
          "qty"
        ],
        "title": "OrderLineIn"
      },
      "OrderLineOut": {
        "properties": {
          "itemId": {
            "type": "string",
            "title": "Itemid"
          },
          "qty": {
            "type": "integer",
            "title": "Qty"
          },
          "unitPrice": {
            "type": "string",
            "title": "Unitprice"
          }
        },
        "type": "object",
        "required": [
          "itemId",
          "qty",
          "unitPrice"
        ],
        "title": "OrderLineOut"
      },
      "OrderListResponse": {
        "properties": {
          "orders": {
            "items": {
              "$ref": "#/components/schemas/OrderResponse"
            },
            "type": "array",
            "title": "Orders"
          }
        },
        "type": "object",
        "required": [
          "orders"
        ],
        "title": "OrderListResponse"
      },
      "OrderResponse": {
        "properties": {
          "orderId": {
            "type": "string",
            "title": "Orderid",
            "examples": [
              "ord_81f2c09a3b7d4e15"
            ]
          },
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "PENDING_PAYMENT"
            ]
          },
          "total": {
            "type": "string",
            "title": "Total",
            "examples": [
              "24.50"
            ]
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "examples": [
              "CAD"
            ]
          },
          "paymentDueBy": {
            "type": "string",
            "title": "Paymentdueby"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLineOut"
            },
            "type": "array",
            "title": "Lines"
          },
          "claimedUnits": {
            "items": {
              "$ref": "#/components/schemas/ClaimedUnit"
            },
            "type": "array",
            "title": "Claimedunits"
          },
          "bonus": {
            "items": {
              "$ref": "#/components/schemas/BonusResult"
            },
            "type": "array",
            "title": "Bonus"
          }
        },
        "type": "object",
        "required": [
          "orderId",
          "status",
          "total",
          "currency",
          "paymentDueBy",
          "createdAt",
          "lines",
          "claimedUnits",
          "bonus"
        ],
        "title": "OrderResponse"
      },
      "PlaceOrderRequest": {
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLineIn"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Lines"
          }
